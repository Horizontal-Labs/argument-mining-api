# ====================================
# Argument Mining API - Environment Variables
# ====================================
# Copy this file to .env and fill in your values

# -------------------------------------
# Required Configuration
# -------------------------------------

# OpenAI API Key for LLM-based models
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# -------------------------------------
# Optional Configuration
# -------------------------------------

# HuggingFace Token (for private models)
# Get from: https://huggingface.co/settings/tokens
HF_TOKEN=
# -------------------------------------
# GitHub Container Registry (For Server Setup)
# -------------------------------------
# These are used by the setup script, not the application itself
# Create a PAT with 'read:packages' scope: https://github.com/settings/tokens

# GITHUB_USER=your-github-username
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# -------------------------------------
# Application Settings
# -------------------------------------

# Port configuration (default: 10234)
PORT=10234